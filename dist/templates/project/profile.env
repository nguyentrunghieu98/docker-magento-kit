# project/profile.env - file profile của dự án, gói chỉ đọc và không bao giờ ghi đè.
# Định dạng KEY=value, mỗi khóa một dòng. Không nháy, không ${...}, không khoảng
# trắng quanh dấu =, giá trị được có khoảng trắng. Không để bí mật ở đây,
# bí mật nằm trong env/*.env. Khóa để trống hoặc bỏ đi thì dùng mặc định của gói.

# --- Khóa bắt buộc ---

# Tên project Compose, quyết định tên container và volume. Để trống thì lấy theo
# tên thư mục Docker root, giữ nguyên tên hiện có khi nhận một dự án đang chạy.
KIT_PROJECT_NAME=

# Domain của site, ví dụ shop.test. Cần cho bin/setup, bin/setup-domain, bin/setup-ssl.
# Lệnh `install.sh new --domain x.test` điền sẵn dòng này.
KIT_DOMAIN=

# Git của src/: remote, nhánh gốc để tạo worktree và nhánh đích của MR.
# Gói không bao giờ push hai nhánh gốc và đích.
KIT_GIT_REMOTE=
KIT_GIT_BASE_BRANCH=
KIT_GIT_TARGET_BRANCH=

# --- Khóa có mặc định, bỏ comment để đổi ---

# Phiên bản PHP: 8.2, 8.3 hoặc 8.4.
# KIT_PHP_VERSION=8.3

# Engine DB là mariadb hoặc mysql. Mặc định của phiên bản là 11.4 cho mariadb, 8.4 cho mysql.
# KIT_DB_ENGINE=mariadb
# KIT_DB_VERSION=11.4

# Image Redis, ví dụ redis:7.2-alpine.
# KIT_REDIS_IMAGE=valkey/valkey:8.1-alpine

# Cổng mở ra máy chủ.
# KIT_HTTP_PORT=80
# KIT_HTTPS_PORT=443
# KIT_DB_PORT=3306
# KIT_REDIS_PORT=6379
# KIT_OPENSEARCH_PORT=9200
# KIT_RABBITMQ_PORT=5672
# KIT_RABBITMQ_MANAGEMENT_PORT=15672

# Heap của OpenSearch.
# KIT_OPENSEARCH_HEAP=1g

# Locale cho static deploy, cách nhau bằng khoảng trắng, ví dụ en_US vi_VN.
# KIT_STATIC_LOCALES=en_US

# Compose profile bật thêm, ví dụ cloudflared.
# KIT_COMPOSE_PROFILES=

# Ghi đè model theo hạng: KIT_MODEL_<HARNESS>_<HẠNG>, ví dụ KIT_MODEL_CLAUDE_DEEP=opus.
