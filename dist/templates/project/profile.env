# project/profile.env - the project profile file; the package only reads it and never overwrites it.
# Format KEY=value, one key per line. No quotes, no ${...}, no whitespace
# around the = sign, values may contain spaces. Do not put secrets here,
# secrets live in env/*.env. A key left empty or removed falls back to the package default.

# --- Required keys ---

# Compose project name, which determines container and volume names. Empty means
# derive it from the Docker root directory name; an existing name is kept when adopting a running project.
KIT_PROJECT_NAME=

# Site domain, for example shop.test. Required by bin/setup, bin/setup-domain and bin/setup-ssl.
# The `install.sh new --domain x.test` command pre-fills this line.
KIT_DOMAIN=

# Git for src/: remote, base branch for creating worktrees and the MR target branch.
# The package never pushes the base and target branches.
KIT_GIT_REMOTE=
KIT_GIT_BASE_BRANCH=
KIT_GIT_TARGET_BRANCH=

# --- Keys with defaults, uncomment to change ---

# PHP version: 8.2, 8.3 or 8.4.
# KIT_PHP_VERSION=8.3

# The DB engine is mariadb or mysql. The default version is 11.4 for mariadb and 8.4 for mysql.
# KIT_DB_ENGINE=mariadb
# KIT_DB_VERSION=11.4

# Redis image, for example redis:7.2-alpine.
# KIT_REDIS_IMAGE=valkey/valkey:8.1-alpine

# Ports published on the host.
# KIT_HTTP_PORT=80
# KIT_HTTPS_PORT=443
# KIT_DB_PORT=3306
# KIT_REDIS_PORT=6379
# KIT_OPENSEARCH_PORT=9200
# KIT_RABBITMQ_PORT=5672
# KIT_RABBITMQ_MANAGEMENT_PORT=15672

# OpenSearch heap.
# KIT_OPENSEARCH_HEAP=1g

# Locales for static deploy, separated by spaces, for example en_US vi_VN.
# KIT_STATIC_LOCALES=en_US

# Extra Compose profiles to enable, for example cloudflared.
# KIT_COMPOSE_PROFILES=

# Model override per tier: KIT_MODEL_<HARNESS>_<TIER>, for example KIT_MODEL_CLAUDE_DEEP=opus.
