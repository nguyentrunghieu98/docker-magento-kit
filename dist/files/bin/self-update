#!/usr/bin/env bash
# bin/self-update - update the package files in this Docker root to another version.
#
#   bin/self-update [--version vX.Y.Z] [--dry-run] [--force] [--source <dir|tarball>]
#
# Three-way update: unmodified package files are overwritten silently, an update
# conflict stops the command before writing anything, and project files are never
# overwritten. Downgrades use the same algorithm. Environment variable: KIT_REPO=<owner>/<repo>.
set -Eeuo pipefail

KIT_REPO="${KIT_REPO:-nguyentrunghieu98/magento-docker-kit}"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd "$SELF_DIR/.." && pwd -P)"
WORK=''

die() {
  printf 'self-update: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  bin/self-update [--version vX.Y.Z] [--dry-run] [--force] [--source <dir|tarball>]

  --version vX.Y.Z   target version (upgrade or downgrade), defaults to the latest tag
  --dry-run          print the plan only, write nothing
  --force            back up conflicting files to .kit/backup/<timestamp>/ then overwrite
  --source <source>  use the package checkout directory or a tarball, no network needed
EOF
}

cleanup() {
  if [[ -n "$WORK" && -d "$WORK" ]]; then
    rm -rf "$WORK"
  fi
  return 0
}
trap cleanup EXIT

# shellcheck source=dist/files/bin/lib/kit-core.sh
source "$SELF_DIR/lib/kit-core.sh"

print_plan() {
  local plan="$1" action mode path n label
  printf 'Update plan %s -> %s\n' "$CURRENT" "$VERSION"
  while IFS=$'\t' read -r action mode path; do
    case "$action" in
      write) label='new file' ;;
      overwrite) label='overwrite' ;;
      conflict) label='CONFLICT' ;;
      remove) label='remove' ;;
      orphan) label='keep (warning: the new version dropped this file but you edited it)' ;;
      template) label='create from template' ;;
      *) continue ;;
    esac
    printf '  %-12s %s\n' "$label" "$path"
  done < "$plan"
  n="$(kit_plan_count "$plan" skip)"
  printf '  (skipped %s files already matching the new version' "$n"
  n="$(kit_plan_count "$plan" keep)"
  if [[ "$n" -gt 0 ]]; then printf ', kept %s locally edited files the new version did not change' "$n"; fi
  printf ')\n'
}

print_conflict_diffs() {
  local plan="$1" action mode path
  while IFS=$'\t' read -r action mode path; do
    [[ "$action" == conflict ]] || continue
    printf '\n--- conflict: %s\n' "$path"
    if [[ -f "$ROOT/$path" && ! -L "$ROOT/$path" ]]; then
      diff -u --label "local/$path" --label "$VERSION/$path" "$ROOT/$path" "$KIT_ROOT/dist/files/$path" || true
    else
      printf '(local path is not a regular file)\n'
    fi
  done < "$plan"
}

compose_changed() {
  awk -F'\t' '$1 != "skip" && $1 != "keep" && $1 != "orphan" && $3 ~ /^compose(\.[^\/]*)?\.ya?ml$/ { found = 1 } END { exit !found }' "$1"
}

main() {
  local version='' source='' dry=0 force=0 plan backup n
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        usage
        exit 0
        ;;
      --version)
        [[ $# -ge 2 ]] || die '--version needs a vX.Y.Z value'
        version="$2"
        shift 2
        ;;
      --version=*)
        version="${1#*=}"
        shift
        ;;
      --source)
        [[ $# -ge 2 ]] || die '--source needs a directory or a tarball'
        source="$2"
        shift 2
        ;;
      --source=*)
        source="${1#*=}"
        shift
        ;;
      --dry-run)
        dry=1
        shift
        ;;
      --force)
        force=1
        shift
        ;;
      *) die "invalid option: $1" ;;
    esac
  done
  if [[ -n "$version" && ! "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
    die "--version must look like vX.Y.Z, got: $version"
  fi

  [[ -f "$ROOT/.kit/manifest" && -f "$ROOT/.kit/version" ]] \
    || die "$ROOT is not managed by the package yet (missing .kit/manifest). Use: install.sh adopt $ROOT"
  CURRENT="$(tr -d '[:space:]' < "$ROOT/.kit/version")"

  WORK="$(mktemp -d "${TMPDIR:-/tmp}/kit-update.XXXXXX")"
  kit_fetch_source "$WORK" "$source" "$version" "$KIT_REPO"
  verify_source "$KIT_ROOT"

  plan="$WORK/plan"
  kit_plan "$ROOT" "$ROOT/.kit/manifest" "$KIT_ROOT/dist/manifest" "$KIT_ROOT/dist/templates" > "$plan"
  print_plan "$plan"

  local conflicts
  conflicts="$(kit_plan_count "$plan" conflict)"
  if [[ "$conflicts" -gt 0 ]]; then
    print_conflict_diffs "$plan"
  fi

  print_extras

  if [[ "$conflicts" -gt 0 && "$force" -eq 0 ]]; then
    printf '\nself-update: %s update conflicts, nothing written. Move customizations to extension points, or rerun with --force to back up and overwrite.\n' "$conflicts" >&2
    exit 1
  fi
  if [[ "$dry" -eq 1 ]]; then
    printf '\nDry run (--dry-run), nothing written.\n'
    if compose_changed "$plan"; then printf 'After the real update, run: bin/restart\n'; fi
    exit 0
  fi

  backup="$ROOT/.kit/backup/$(date +%Y%m%d-%H%M%S)"
  kit_apply "$ROOT" "$plan" "$KIT_ROOT/dist/files" "$KIT_ROOT/dist/templates" "$force" "$backup"
  kit_write_state "$ROOT" "$KIT_ROOT/dist/manifest" "$VERSION"

  n="$(kit_plan_count "$plan" conflict)"
  printf '\nUpdated to %s.\n' "$VERSION"
  if [[ "$n" -gt 0 ]]; then
    printf 'Backed up %s conflicting files to %s\n' "$n" "${backup#"$ROOT"/}"
  fi
  if compose_changed "$plan"; then
    printf 'Compose files changed. Run bin/restart to apply.\n'
  fi
}

# Changelog between two versions and missing profile keys. Print only, write nothing.
print_extras() {
  local text missing
  text="$(kit_changelog "$KIT_ROOT/CHANGELOG.md" "$CURRENT" "$VERSION")"
  if [[ -n "$text" ]]; then
    printf '\nChangelog %s -> %s:\n%s\n' "$CURRENT" "$VERSION" "$text"
  fi
  missing="$(kit_profile_missing "$ROOT/project/profile.env" "$KIT_ROOT/dist/templates/project/profile.env")"
  if [[ -n "$missing" ]]; then
    printf '\nproject/profile.env is missing keys from the new template (nothing written, add them if needed):\n'
    printf '%s\n' "$missing" | sed 's/^/  /'
  fi
}

main "$@"
