#!/usr/bin/env bash
# bin/docker-compose - the single place that assembles the project Compose configuration.
#
# Loads project/profile.env then .kit/runtime.env, passes -p "$KIT_PROJECT_NAME",
# turns KIT_COMPOSE_PROFILES into COMPOSE_PROFILES and picks Compose files in
# this order: base, DB file per KIT_DB_ENGINE, dev, Linux, worktree overlay (when
# .active-src is a symlink), compose.override.yaml last if present.
set -Eeuo pipefail

KIT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$KIT_ROOT"

# shellcheck source=bin/lib/profile.sh
source "$KIT_ROOT/bin/lib/profile.sh"
kit_profile_load "$KIT_ROOT" || exit 1

case "$KIT_DB_ENGINE" in
  mariadb | mysql) ;;
  *)
    printf 'KIT_DB_ENGINE must be mariadb or mysql, got: %s\n' "$KIT_DB_ENGINE" >&2
    exit 1
    ;;
esac

if docker compose version > /dev/null 2>&1; then
  DOCKER_COMPOSE=(docker compose)
else
  DOCKER_COMPOSE=(docker-compose)
fi

COMPOSE_FILES=("compose.yaml" "compose.db-${KIT_DB_ENGINE}.yaml" "compose.healthcheck.yaml")

# --no-dev drops the dev file, the Linux file and the worktree overlay. This flag
# is not forwarded to docker compose.
LOAD_DEV_FILES=1
if [[ "${1:-}" == "--no-dev" ]]; then
  shift 1
  LOAD_DEV_FILES=0
fi

if [[ "$LOAD_DEV_FILES" == "1" ]]; then
  COMPOSE_FILES+=("compose.dev.yaml")
  if [[ "$(uname -s)" == "Linux" && -f compose.dev-linux.yaml ]]; then
    COMPOSE_FILES+=("compose.dev-linux.yaml")
  fi
  # The worktree overlay loads last within the dev group so it wins the /var/www/html volume.
  if [[ -L ".active-src" && -f compose.worktree.yaml ]]; then
    COMPOSE_FILES+=("compose.worktree.yaml")
  fi
fi

# The project changes the Compose structure here; loaded last.
if [[ -f compose.override.yaml ]]; then
  COMPOSE_FILES+=("compose.override.yaml")
fi

COMPOSE_FILES_PREFIXED=()
for file in "${COMPOSE_FILES[@]}"; do
  COMPOSE_FILES_PREFIXED+=("-f" "$file")
done

kit_profile_export
export LOAD_DEV_FILES
export COMPOSE_PROFILES="$KIT_COMPOSE_PROFILES"

exec "${DOCKER_COMPOSE[@]}" -p "$KIT_PROJECT_NAME" "${COMPOSE_FILES_PREFIXED[@]}" "$@"
