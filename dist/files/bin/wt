#!/usr/bin/env bash
# bin/wt - run a single Docker stack across multiple worktrees of the Magento repo.
#
# Layout (paths relative to the Docker root):
#   src/                       main checkout of the Magento repo, never moved
#   .worktrees/<dir>           worktree, <dir> is the branch name with "/" replaced by "-"
#   .active-src -> <checkout>  what Docker mounts at /var/www/html
#   compose.worktree.yaml      overlay mounting .active-src, loaded by bin/docker-compose
#
# The only valid way to create a worktree is `bin/wt create`. Every worktree shares one
# DB, vendor/, node_modules/ and pub/media. The Git keys (remote, base branch) come from
# project/profile.env, never auto-detected.
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
MAIN_DIR="$PROJECT_ROOT/src"
WORKTREES_DIR="$PROJECT_ROOT/.worktrees"
ACTIVE_LINK="$PROJECT_ROOT/.active-src"
COMPOSE_WRAPPER="$PROJECT_ROOT/bin/docker-compose"
MAGENTO_CLI="$PROJECT_ROOT/bin/magento"
AGENT_CLI="$PROJECT_ROOT/bin/agent"
PHP_SERVICES=(app phpfpm)

# Runtime directories Magento needs in a fresh checkout (all ignored by Git). Created here
# so the owner is the host user, not the Docker daemon (root).
RUNTIME_DIRS=(app/code app/design app/etc generated var/log var/report pub/static pub/media)
SHARED_DIRS=(bin dev lib phpserver setup vendor node_modules)

# Magento core files the repo .gitignore whitelist misses, copied from src/ into a worktree
# when still missing. Paths relative to the Magento root.
CORE_FILES=(
  app/bootstrap.php
  app/autoload.php
  app/.htaccess
  app/etc/NonComposerComponentRegistration.php
  app/etc/registration_globlist.php
  app/etc/vendor_path.php
  app/etc/env.php
  pub/index.php
  pub/cron.php
  pub/get.php
  pub/health_check.php
  pub/static.php
  pub/.htaccess
  pub/.user.ini
  .user.ini
  php.ini
  nginx.conf.sample
  package.json
  Gruntfile.js
  grunt-config.json
)

# Branch name pattern: <type>/<slug>.
BRANCH_PATTERN='^[a-z][a-z0-9]*/[A-Za-z0-9][A-Za-z0-9._-]*$'

# shellcheck source=bin/lib/profile.sh
source "$SCRIPT_DIR/lib/profile.sh"

info() { printf '%s\n' "$*"; }
ok() { printf 'OK: %s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: bin/wt <command> [arguments]

  create <type>/<slug>          Create a worktree in .worktrees/ from <remote>/<base branch>
  create --review-mr <id>       Create a detached worktree review-mr<id> from the remote MR
         [--ref <branch>]       (or from <remote>/<branch> when --ref is given)
  list                          List worktrees, branches and the active worktree
  use <name|path|branch>        Make the single stack serve that worktree
  status                        Show the active worktree and the container state
  path <name|path|branch>       Print the absolute path of the worktree
  prepare <name|path|branch>    Copy the core files .gitignore misses into the worktree
  shell <name|path|branch>      Open a shell in the worktree
  remove <name>                 Delete a clean worktree in .worktrees/ that is not active
  adopt <path>                  Move a misplaced worktree to .worktrees/<dir> then prepare
  prune [--dry-run]             Delete clean worktrees merged into <remote>/<target branch>
                                and review worktrees, keep the branch. --dry-run only lists
  doctor                        Compare the phpfpm mount with .active-src, check base_url and KIT_* keys
  mounts                        Show the Docker mounts the stack will use

  <name> is 'main', a directory in .worktrees/, a branch name or an absolute path.
  Switching worktrees only recreates app and phpfpm, the DB is never touched.
USAGE
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing command: $1"
}

compose() {
  ( cd "$PROJECT_ROOT" && "$COMPOSE_WRAPPER" "$@" )
}

docker_online() {
  command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1
}

# Load the profile file and check the required Git keys. Call it before anything that needs the remote.
load_git_keys() {
  kit_profile_load "$PROJECT_ROOT" || die 'profile file has a syntax error, fix project/profile.env'
  kit_profile_require KIT_GIT_REMOTE KIT_GIT_BASE_BRANCH || die 'Fill in the Git keys in project/profile.env and run again'
}

require_main() {
  [[ -d "$MAIN_DIR/.git" ]] || die "No $MAIN_DIR/.git, src/ must be the main checkout of the Magento repo"
  git -C "$MAIN_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die 'src/ is not a Git work tree of the Magento repo'
}

# Read-only commands use this one: without .active-src, src/ is treated as active.
require_main_for_read() {
  require_main
  if [[ -e "$ACTIVE_LINK" && ! -L "$ACTIVE_LINK" ]]; then
    die "$ACTIVE_LINK exists but is not a symlink, move it away"
  fi
  if [[ -L "$ACTIVE_LINK" && ! -d "$ACTIVE_LINK" ]]; then
    die ".active-src is broken -> '$(readlink "$ACTIVE_LINK")', run bin/wt use main to fix it"
  fi
  return 0
}

# Write commands: create .active-src -> src and .worktrees/ when missing (src/ left untouched).
ensure_active() {
  require_main_for_read
  mkdir -p "$WORKTREES_DIR"
  if [[ ! -L "$ACTIVE_LINK" ]]; then
    ln -s "$MAIN_DIR" "$ACTIVE_LINK" || die 'Cannot create the .active-src symlink'
    info 'Created .active-src -> src (src/ left untouched)'
  fi
}

worktree_paths() {
  git -C "$MAIN_DIR" worktree list --porcelain | sed -n 's/^worktree //p'
}

branch_of() {
  local name
  name="$(git -C "$1" rev-parse --abbrev-ref HEAD 2>/dev/null)" || { printf '(unknown)\n'; return 0; }
  if [[ "$name" == 'HEAD' ]]; then printf '(detached)\n'; else printf '%s\n' "$name"; fi
}

alias_for() {
  local path="$1"
  if [[ "$path" == "$MAIN_DIR" ]]; then printf 'main\n'; return 0; fi
  if [[ "$path" == "$WORKTREES_DIR/"* ]]; then printf '%s\n' "${path#"$WORKTREES_DIR/"}"; return 0; fi
  printf 'wt/%s\n' "$(basename "$path")"
}

is_owned_worktree() {
  local path="$1"
  [[ "$path" == "$MAIN_DIR" ]] && return 0
  worktree_paths | grep -Fqx "$path"
}

verify_checkout() {
  local path="$1"
  [[ -d "$path" ]] || die "Not a directory: $path"
  is_owned_worktree "$path" || die "Not a worktree of the Magento repo in src/: $path"
  [[ -f "$path/composer.json" ]] || die "Missing composer.json, not a Magento root: $path"
}

# Only the main checkout and paths inside .worktrees/ may serve.
require_standard_location() {
  local path="$1"
  case "$path" in
    "$MAIN_DIR" | "$WORKTREES_DIR"/*) return 0 ;;
  esac
  die "Refusing $path because it is outside .worktrees/. If this is a worktree of src/, move it to the standard location with: bin/wt adopt $path"
}

resolve_target() {
  local arg="${1:-}" path real
  local -a matches=()
  [[ -n "$arg" ]] || die 'Missing worktree name, path or branch'

  if [[ "$arg" == 'main' ]]; then realpath "$MAIN_DIR"; return 0; fi
  if [[ -d "$arg" ]]; then realpath "$arg"; return 0; fi
  if [[ -d "$WORKTREES_DIR/$arg" ]]; then realpath "$WORKTREES_DIR/$arg"; return 0; fi

  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    [[ "$path" == "$MAIN_DIR" ]] && continue
    if [[ "$path" == "$arg" \
       || "$(alias_for "$path")" == "$arg" \
       || "$(branch_of "$path")" == "$arg" \
       || "$(basename "$path")" == "${arg#wt/}" ]]; then
      matches+=("$path")
    fi
  done < <(worktree_paths)

  if [[ "${#matches[@]}" -eq 0 ]]; then
    {
      printf 'ERROR: No worktree named: %s\n' "$arg"
      printf 'Existing worktrees:\n'
      worktree_paths | while IFS= read -r path; do
        printf '  %-26s %s\n' "$(alias_for "$path")" "$path"
      done
    } >&2
    exit 1
  fi
  if [[ "${#matches[@]}" -gt 1 ]]; then
    {
      printf "ERROR: '%s' matches several worktrees, use one of:\n" "$arg"
      printf '%s\n' "${matches[@]}" | while IFS= read -r path; do
        printf '  %s\n' "$path"
      done
    } >&2
    exit 1
  fi
  real="$(realpath "${matches[0]}")"
  printf '%s\n' "$real"
}

active_path() {
  if [[ -L "$ACTIVE_LINK" ]]; then
    ( cd -P "$ACTIVE_LINK" && pwd -P )
  else
    printf '%s\n' "$MAIN_DIR"
  fi
}

active_name() {
  alias_for "$(active_path)"
}

detect_running_php() {
  RUNNING_PHP_SERVICES=()
  docker_online || return 0
  local running service
  running="$(compose ps --services --status running)" \
    || die 'Cannot query Docker Compose, nothing changed'
  for service in "${PHP_SERVICES[@]}"; do
    if printf '%s\n' "$running" | grep -Fqx "$service"; then
      RUNNING_PHP_SERVICES+=("$service")
    fi
  done
}

repoint_active() {
  local target="$1" tmp="$ACTIVE_LINK.tmp.$$"
  rm -f "$tmp"
  ln -s "$target" "$tmp" || die "Cannot create symlink: $tmp"
  if ! mv -Tf "$tmp" "$ACTIVE_LINK" 2>/dev/null; then
    rm -f "$tmp"
    die "$ACTIVE_LINK is not a symlink, move it away"
  fi
}

prepare_local_files() {
  local dest="$1" dir file copied=0
  for dir in "${RUNTIME_DIRS[@]}" "${SHARED_DIRS[@]}"; do
    mkdir -p "$dest/$dir"
  done

  # Core files not in Git: copy only when the checkout ignores them, so the copy
  # is never staged by mistake. app/etc/env.php carries the shared DB and Redis settings.
  for file in "${CORE_FILES[@]}"; do
    [[ -f "$MAIN_DIR/$file" ]] || continue
    [[ -e "$dest/$file" ]] && continue
    if git -C "$dest" check-ignore -q -- "$file"; then
      mkdir -p "$dest/$(dirname "$file")"
      cp -p "$MAIN_DIR/$file" "$dest/$file"
      copied=$((copied + 1))
    else
      warn "$file was not copied because $dest does not ignore it"
    fi
  done

  # nginx.conf is generated from nginx.conf.sample and ignored by Git, but nginx cannot start
  # without it.
  if [[ ! -e "$dest/nginx.conf" ]]; then
    if [[ -f "$MAIN_DIR/nginx.conf" ]]; then
      cp -p "$MAIN_DIR/nginx.conf" "$dest/nginx.conf"
      copied=$((copied + 1))
    elif [[ -f "$MAIN_DIR/nginx.conf.sample" ]]; then
      cp -p "$MAIN_DIR/nginx.conf.sample" "$dest/nginx.conf"
      copied=$((copied + 1))
    fi
  fi

  [[ "$copied" -gt 0 ]] && info "Copied $copied core files missing from Git into $dest"

  # Agent kit: install only when the command exists, skip when it does not.
  if [[ "$dest" != "$MAIN_DIR" && -x "$AGENT_CLI" ]]; then
    ( cd "$dest" && "$AGENT_CLI" install ) || warn 'bin/agent install failed, the worktree is still usable, run it again later'
  fi
  return 0
}

warn_lock_mismatch() {
  local dest="$1"
  [[ "$dest" != "$MAIN_DIR" ]] || return 0
  if [[ -f "$MAIN_DIR/composer.lock" && -f "$dest/composer.lock" ]] \
     && ! cmp -s "$MAIN_DIR/composer.lock" "$dest/composer.lock"; then
    warn 'composer.lock differs from src/, the shared vendor/ may not match this branch.'
    warn 'If something breaks, run: bin/cli composer install (this command updates the shared vendor/)'
  fi
}

# --------------------------------------------------------------------------
# Git driven by the profile keys
# --------------------------------------------------------------------------

# Check the remote exists in src/ then fetch. Stop and name the key to fix on error.
fetch_remote() {
  git -C "$MAIN_DIR" remote get-url "$KIT_GIT_REMOTE" >/dev/null 2>&1 \
    || die "KIT_GIT_REMOTE=$KIT_GIT_REMOTE: src/ has no such remote. Fix KIT_GIT_REMOTE in project/profile.env"
  info "Fetch $KIT_GIT_REMOTE..."
  git -C "$MAIN_DIR" fetch --quiet "$KIT_GIT_REMOTE" \
    || die "Fetch $KIT_GIT_REMOTE failed. Check KIT_GIT_REMOTE in project/profile.env and the network connection"
}

# Print ref <remote>/<base> after the fetch, stop when it does not exist.
base_ref() {
  local ref="refs/remotes/$KIT_GIT_REMOTE/$KIT_GIT_BASE_BRANCH"
  git -C "$MAIN_DIR" rev-parse -q --verify "${ref}^{commit}" >/dev/null 2>&1 \
    || die "Ref $KIT_GIT_REMOTE/$KIT_GIT_BASE_BRANCH does not exist after the fetch. Fix KIT_GIT_BASE_BRANCH (or KIT_GIT_REMOTE) in project/profile.env"
  printf '%s\n' "$ref"
}

# --------------------------------------------------------------------------
# Commands
# --------------------------------------------------------------------------

create_cmd() {
  need_command git
  require_main
  local branch='' review_id='' ref_branch=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --review-mr)
        [[ $# -ge 2 ]] || die '--review-mr needs an MR number'
        review_id="$2"; shift 2 ;;
      --ref)
        [[ $# -ge 2 ]] || die '--ref needs a branch name on the remote'
        ref_branch="$2"; shift 2 ;;
      -*) die "Invalid argument: $1" ;;
      *)
        [[ -z "$branch" ]] || die "Unexpected argument: $1"
        branch="$1"; shift ;;
    esac
  done

  if [[ -n "$review_id" ]]; then
    [[ -z "$branch" ]] || die 'create --review-mr does not take a branch name'
    create_review "$review_id" "$ref_branch"
    return 0
  fi
  [[ -z "$ref_branch" ]] || die '--ref can only be used with --review-mr'
  [[ -n "$branch" ]] || die 'Usage: bin/wt create <type>/<slug>'
  [[ "$branch" =~ $BRANCH_PATTERN ]] && git check-ref-format --branch "$branch" >/dev/null 2>&1 \
    || die "Branch name '$branch' does not match <type>/<slug>, for example feature/cart. <type> is lowercase, <slug> has letters, digits, '.', '_' or '-'"

  load_git_keys
  local dir dest base
  dir="${branch//\//-}"
  dest="$WORKTREES_DIR/$dir"
  [[ ! -e "$dest" ]] || die "Path already exists: $dest"
  git -C "$MAIN_DIR" show-ref --verify --quiet "refs/heads/$branch" \
    && die "Branch $branch already exists in src/. bin/wt create always creates a new branch from $KIT_GIT_REMOTE/$KIT_GIT_BASE_BRANCH, choose another name"

  fetch_remote
  base="$(base_ref)"
  ensure_active
  git -C "$MAIN_DIR" worktree add --no-track -b "$branch" "$dest" "$base" >/dev/null
  dest="$(realpath "$dest")"
  prepare_local_files "$dest"
  info "Worktree ready: $dest"
  info "Branch $branch created from $KIT_GIT_REMOTE/$KIT_GIT_BASE_BRANCH"
  info "Make the stack serve it: bin/wt use '$dir'"
}

create_review() {
  local id="$1" ref_branch="$2" dir dest target
  [[ "$id" =~ ^[0-9]+$ ]] || die "MR number must be an integer, got: $id"
  load_git_keys
  dir="review-mr$id"
  dest="$WORKTREES_DIR/$dir"
  [[ ! -e "$dest" ]] || die "Path already exists: $dest"

  fetch_remote
  if [[ -n "$ref_branch" ]]; then
    target="refs/remotes/$KIT_GIT_REMOTE/$ref_branch"
    git -C "$MAIN_DIR" rev-parse -q --verify "${target}^{commit}" >/dev/null 2>&1 \
      || die "Ref $KIT_GIT_REMOTE/$ref_branch does not exist after the fetch"
  else
    git -C "$MAIN_DIR" fetch --quiet "$KIT_GIT_REMOTE" "refs/merge-requests/$id/head" 2>/dev/null \
      || die "Cannot fetch refs/merge-requests/$id/head from $KIT_GIT_REMOTE. If the MR uses another ref, pass --ref <branch>"
    target='FETCH_HEAD'
  fi
  ensure_active
  git -C "$MAIN_DIR" worktree add --detach "$dest" "$target" >/dev/null
  dest="$(realpath "$dest")"
  prepare_local_files "$dest"
  info "Review worktree ready (detached): $dest"
  info "Make the stack serve it: bin/wt use '$dir'"
}

prepare_cmd() {
  require_main_for_read
  local target
  target="$(resolve_target "${1:-}")"
  verify_checkout "$target"
  prepare_local_files "$target"
  warn_lock_mismatch "$target"
  info "Prepared: $target"
}

use_cmd() {
  [[ $# -eq 1 ]] || die 'Usage: bin/wt use <name|path|branch>'
  require_main_for_read
  local target old_target
  target="$(resolve_target "$1")"
  require_standard_location "$target"
  verify_checkout "$target"
  ensure_active
  prepare_local_files "$target"
  warn_lock_mismatch "$target"

  old_target="$(active_path)"
  if [[ "$target" == "$old_target" ]]; then
    info "Already active: $(active_name)"
    return 0
  fi

  detect_running_php

  if [[ "${#RUNNING_PHP_SERVICES[@]}" -gt 0 ]]; then
    info "Stopping PHP and Nginx only: ${RUNNING_PHP_SERVICES[*]}"
    compose stop "${RUNNING_PHP_SERVICES[@]}" || die 'Cannot stop the service, worktree not changed'
  fi

  repoint_active "$target"

  if [[ "${#RUNNING_PHP_SERVICES[@]}" -gt 0 ]]; then
    info 'Recreating the app and phpfpm mounts, DB, Redis, OpenSearch, RabbitMQ keep running...'
    if ! compose up -d --no-deps --force-recreate "${RUNNING_PHP_SERVICES[@]}"; then
      warn 'Recreating the container failed, putting the symlink back.'
      repoint_active "$old_target"
      compose up -d --no-deps --force-recreate "${RUNNING_PHP_SERVICES[@]}" \
        || warn 'Restoring the service failed, check bin/status and the Docker logs.'
      die 'Worktree switch cancelled, the old worktree is unchanged'
    fi
    if printf '%s\n' "${RUNNING_PHP_SERVICES[@]}" | grep -Fqx 'phpfpm' && [[ -x "$MAGENTO_CLI" ]]; then
      info 'Clearing the Magento cache (best effort)...'
      ( cd "$PROJECT_ROOT" && "$MAGENTO_CLI" cache:clean ) \
        || warn 'Cache clean failed, run bin/magento cache:clean once Magento is ready.'
    fi
    info 'Cron and the watcher run inside phpfpm, restart them if you use them (bin/cron start, bin/watch).'
  else
    info 'PHP and Nginx are not running. Start the stack with: bin/start'
  fi

  info "Active worktree: $(active_name) ($target)"
  info 'Check: bin/magento --version then open the storefront in a browser'
}

list_cmd() {
  require_main_for_read
  local path mark active
  active="$(active_path)"
  info "Active worktree: $(active_name)"
  info "Path: $active"
  printf '\n%-3s %-28s %-30s %s\n' '' 'NAME' 'BRANCH' 'PATH'
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    mark=' '
    [[ "$path" == "$active" ]] && mark='*'
    printf '%-3s %-28s %-30s %s\n' "$mark" "$(alias_for "$path")" "$(branch_of "$path")" "$path"
  done < <(worktree_paths)
}

path_cmd() {
  [[ $# -eq 1 ]] || die 'Usage: bin/wt path <name|path|branch>'
  require_main_for_read
  local target
  target="$(resolve_target "$1")"
  verify_checkout "$target"
  printf '%s\n' "$target"
}

status_cmd() {
  require_main_for_read
  info "Active worktree: $(active_name)"
  info "Path: $(active_path)"
  info "Branch: $(branch_of "$(active_path)")"
  info 'Changed files in the active checkout:'
  git -C "$(active_path)" status --short
  if docker_online; then
    info 'Docker services:'
    compose ps
  else
    info 'Docker daemon is off or unreachable.'
  fi
}

mounts_cmd() {
  require_main_for_read
  docker_online || die 'Docker daemon is off'
  compose config | sed -n '/^  app:/,/^  [a-z]/p;/^  phpfpm:/,/^  [a-z]/p' | sed -n '1,120p'
}

shell_cmd() {
  require_main_for_read
  local name="${1:-}" target
  [[ -n "$name" ]] || die 'Usage: bin/wt shell <name|path|branch>'
  target="$(resolve_target "$name")"
  verify_checkout "$target"
  cd "$target"
  exec "${SHELL:-/bin/bash}"
}

remove_cmd() {
  require_main_for_read
  local name="${1:-}" target
  [[ $# -eq 1 && -n "$name" ]] || die 'Usage: bin/wt remove <name>'
  [[ "$name" != 'main' ]] || die 'Cannot delete the main checkout in src/'
  target="$(resolve_target "$name")"
  [[ "$target" != "$MAIN_DIR" ]] || die 'Cannot delete the main checkout in src/'
  case "$target" in
    "$WORKTREES_DIR"/*) ;;
    *) die "Refusing to delete a path outside .worktrees/: $target" ;;
  esac
  is_owned_worktree "$target" || die "Not a linked worktree of src/: $target"
  [[ "$(active_path)" != "$target" ]] || die 'Cannot delete the active worktree, run bin/wt use main first'

  if ! git -C "$MAIN_DIR" worktree remove "$target"; then
    die "Cannot delete $target (modified or untracked files left?), the branch is kept"
  fi
  info "Deleted worktree: $name (local branch kept)"
}

# --------------------------------------------------------------------------
# adopt, prune, doctor
# --------------------------------------------------------------------------

adopt_cmd() {
  [[ $# -eq 1 ]] || die 'Usage: bin/wt adopt <path>'
  need_command git
  require_main_for_read
  [[ -d "$1" ]] || die "Not a directory: $1"
  local target branch dir dest
  target="$(realpath "$1")"
  [[ "$target" != "$MAIN_DIR" ]] || die 'Cannot adopt the main checkout in src/'
  worktree_paths | grep -Fqx "$target" \
    || die "Not a worktree of the Magento repo in src/: $target. Only worktrees created with git worktree from src/ can be adopted"
  [[ "$(active_path)" != "$target" ]] \
    || die 'This worktree is active, run bin/wt use main first then adopt it again'

  if [[ "$target" == "$WORKTREES_DIR"/* ]]; then
    info "Already at the standard location: $target"
    prepare_local_files "$target"
    warn_lock_mismatch "$target"
    return 0
  fi

  branch="$(branch_of "$target")"
  case "$branch" in
    '(detached)' | '(unknown)') dir="$(basename "$target")" ;;
    *) dir="${branch//\//-}" ;;
  esac
  dest="$WORKTREES_DIR/$dir"
  [[ ! -e "$dest" ]] || die "Path already exists: $dest, not overwriting. Rename or delete it first"

  ensure_active
  git -C "$MAIN_DIR" worktree move "$target" "$dest" \
    || die "git worktree move failed, the worktree is still at $target (locked? run git worktree unlock)"
  dest="$(realpath "$dest")"
  prepare_local_files "$dest"
  warn_lock_mismatch "$dest"
  info "Adopted worktree: $target -> $dest"
  info "Make the stack serve it: bin/wt use '$dir'"
}

# Classify every linked worktree for prune. Fill the PRUNE_* arrays, one path per element,
# in priority order: active, has changes, outside the standard location,
# review, merged, not merged.
classify_for_prune() {
  local target_ref="$1" path active
  PRUNE_REMOVE=() PRUNE_REVIEW=() PRUNE_MERGED=() PRUNE_DIRTY=() PRUNE_OUTSIDE=() PRUNE_UNMERGED=() PRUNE_ACTIVE=()
  active="$(active_path)"
  while IFS= read -r path; do
    [[ -n "$path" && "$path" != "$MAIN_DIR" ]] || continue
    if [[ "$path" == "$active" ]]; then
      PRUNE_ACTIVE+=("$path"); continue
    fi
    if [[ -n "$(git -C "$path" status --porcelain 2>/dev/null)" ]]; then
      PRUNE_DIRTY+=("$path"); continue
    fi
    if [[ "$path" != "$WORKTREES_DIR"/* ]]; then
      PRUNE_OUTSIDE+=("$path"); continue
    fi
    if [[ "$(branch_of "$path")" == '(detached)' && "$(basename "$path")" == review-mr* ]]; then
      PRUNE_REVIEW+=("$path"); PRUNE_REMOVE+=("$path"); continue
    fi
    if git -C "$path" merge-base --is-ancestor HEAD "$target_ref" 2>/dev/null; then
      PRUNE_MERGED+=("$path"); PRUNE_REMOVE+=("$path")
    else
      PRUNE_UNMERGED+=("$path")
    fi
  done < <(worktree_paths)
}

print_prune_group() {
  local title="$1" note="$2" path
  shift 2
  [[ $# -gt 0 ]] || return 0
  info "$title"
  for path in "$@"; do
    printf '  %-26s %-30s %s\n' "$(alias_for "$path")" "$(branch_of "$path")" "$path"
  done
  [[ -z "$note" ]] || info "  -> $note"
}

prune_cmd() {
  local dry=0 arg
  for arg in "$@"; do
    case "$arg" in
      --dry-run) dry=1 ;;
      *) die 'Usage: bin/wt prune [--dry-run]' ;;
    esac
  done
  need_command git
  require_main_for_read
  kit_profile_load "$PROJECT_ROOT" || die 'profile file has a syntax error, fix project/profile.env'
  kit_profile_require KIT_GIT_REMOTE KIT_GIT_TARGET_BRANCH || die 'Fill in the Git keys in project/profile.env and run again'
  fetch_remote
  local target_ref="refs/remotes/$KIT_GIT_REMOTE/$KIT_GIT_TARGET_BRANCH"
  git -C "$MAIN_DIR" rev-parse -q --verify "${target_ref}^{commit}" >/dev/null 2>&1 \
    || die "Ref $KIT_GIT_REMOTE/$KIT_GIT_TARGET_BRANCH does not exist after the fetch. Fix KIT_GIT_TARGET_BRANCH (or KIT_GIT_REMOTE) in project/profile.env"

  classify_for_prune "$target_ref"

  info "Checking against $KIT_GIT_REMOTE/$KIT_GIT_TARGET_BRANCH"
  print_prune_group 'Will delete, clean and merged:' '' ${PRUNE_MERGED[@]+"${PRUNE_MERGED[@]}"}
  print_prune_group 'Will delete, review worktrees:' '' ${PRUNE_REVIEW[@]+"${PRUNE_REVIEW[@]}"}
  [[ "${#PRUNE_REMOVE[@]}" -gt 0 ]] || info 'No worktrees to delete.'
  print_prune_group 'Has changes, report only, not touched:' 'commit or discard the changes then run again' ${PRUNE_DIRTY[@]+"${PRUNE_DIRTY[@]}"}
  print_prune_group 'Outside .worktrees/, prune does not delete:' 'move it to the standard location with bin/wt adopt <path>' ${PRUNE_OUTSIDE[@]+"${PRUNE_OUTSIDE[@]}"}
  print_prune_group 'Not merged, kept:' '' ${PRUNE_UNMERGED[@]+"${PRUNE_UNMERGED[@]}"}
  print_prune_group 'Active, kept:' '' ${PRUNE_ACTIVE[@]+"${PRUNE_ACTIVE[@]}"}

  if [[ "$dry" -eq 1 ]]; then
    info 'Dry run (--dry-run), nothing deleted.'
    return 0
  fi

  local failed=0 p
  for p in ${PRUNE_REMOVE[@]+"${PRUNE_REMOVE[@]}"}; do
    if git -C "$MAIN_DIR" worktree remove "$p"; then
      info "Deleted: $(alias_for "$p") (local branch kept)"
    else
      warn "Cannot delete $p"
      failed=1
    fi
  done
  return "$failed"
}

# Get the host from a URL (drop the scheme, path and port).
url_host() {
  local h="${1#*://}"
  h="${h%%/*}"
  printf '%s\n' "${h%%:*}"
}

doctor_cmd() {
  require_main_for_read
  local issues=0 key active cid mount base host
  info '--- Profile ---'
  if ! kit_profile_load "$PROJECT_ROOT"; then
    warn 'profile file has a syntax error, fix project/profile.env'
    return 1
  fi
  for key in $(kit_profile_missing_required); do
    warn "Missing required key $key, add it to project/profile.env"
    issues=$((issues + 1))
  done
  for key in $KIT_PROFILE_UNKNOWN; do
    warn "Unknown key $key in the profile, the package does not read this key (typo or removed key?)"
    issues=$((issues + 1))
  done
  if [[ "$issues" -gt 0 ]]; then
    info 'Fix project/profile.env then run bin/wt doctor again to check the mount and base_url.'
    return 1
  fi
  ok 'Profile has all required keys and no unknown keys'

  info '--- Active worktree ---'
  active="$(active_path)"
  info "Target of .active-src: $active"

  info '--- Docker ---'
  if ! docker_online; then
    info 'SKIPPED: Docker daemon is off, not checking the mount and base_url.'
  else
    cid="$(compose ps -q phpfpm 2>/dev/null | head -n1)" || cid=''
    if [[ -z "$cid" ]]; then
      info 'SKIPPED: phpfpm is not running, not checking the mount.'
    else
      mount="$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/www/html"}}{{.Source}}{{end}}{{end}}' "$cid" 2>/dev/null)" || mount=''
      if [[ -z "$mount" ]]; then
        warn 'Cannot read the phpfpm /var/www/html mount through docker inspect'
        issues=$((issues + 1))
      elif [[ "$(realpath -m "$mount")" == "$active" ]]; then
        ok "phpfpm mounts the right path $active"
      else
        warn "phpfpm mounts $mount but .active-src points to $active. Run: bin/wt use '$(active_name)' to recreate the mount"
        issues=$((issues + 1))
      fi

      base="$(cd "$PROJECT_ROOT" && bin/mysql -N -e "select value from core_config_data where path='web/unsecure/base_url' and scope='default' limit 1" < /dev/null 2>/dev/null | head -n1)" || base=''
      if [[ -z "$base" ]]; then
        info 'SKIPPED: cannot read base_url from the DB.'
      elif [[ -z "$KIT_DOMAIN" ]]; then
        info 'SKIPPED: KIT_DOMAIN is empty, cannot compare base_url.'
      else
        host="$(url_host "$base")"
        if [[ "$host" == "$KIT_DOMAIN" ]]; then
          ok "base_url matches KIT_DOMAIN ($KIT_DOMAIN)"
        else
          warn "base_url in the DB is $base (host $host) but KIT_DOMAIN=$KIT_DOMAIN. The package does not sync it, run bin/setup-domain or fix KIT_DOMAIN"
          issues=$((issues + 1))
        fi
      fi
    fi
  fi

  if [[ "$issues" -gt 0 ]]; then
    warn "Found $issues issues to fix"
    return 1
  fi
  ok 'No issues found'
}

main() {
  local action="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$action" in
    create) create_cmd "$@" ;;
    prepare) prepare_cmd "$@" ;;
    list) [[ $# -eq 0 ]] || die 'Usage: bin/wt list'; list_cmd ;;
    use | switch) use_cmd "$@" ;;
    status) [[ $# -eq 0 ]] || die 'Usage: bin/wt status'; status_cmd ;;
    mounts) [[ $# -eq 0 ]] || die 'Usage: bin/wt mounts'; mounts_cmd ;;
    path) path_cmd "$@" ;;
    shell) shell_cmd "$@" ;;
    remove | rm) remove_cmd "$@" ;;
    adopt) adopt_cmd "$@" ;;
    prune) prune_cmd "$@" ;;
    doctor) [[ $# -eq 0 ]] || die 'Usage: bin/wt doctor'; doctor_cmd ;;
    help | -h | --help) usage ;;
    *) usage >&2; die "Unknown command: $action" ;;
  esac
}

main "$@"
