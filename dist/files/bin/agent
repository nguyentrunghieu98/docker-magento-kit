#!/usr/bin/env bash
# bin/agent - install the agent kit into a checkout (Docker root, src/ or worktree).
#
#   bin/agent install [--target <directory>] [--force]
#
# Source: the package's agent/ and the project's project/agent/. The target defaults to the current directory.
# Generated in the target:
#   AGENTS.md    from agent/AGENTS.template.md plus the values in project/profile.env,
#                with project/agent/AGENTS.project.md appended at the end (at most 20 lines)
#   CLAUDE.md    from agent/CLAUDE.template.md, including @AGENTS.md
#   .claude/skills/<name>/ and .agents/skills/<name>/   package and project skills
#   .claude/agents/<name>.md                            role for Claude Code, model is an alias
#   ${CODEX_HOME:-~/.codex}/agents/magento-*.toml       role for Codex, model split from <model>:<effort>
# Roles: agent/roles/ and project/agent/roles/ share one mechanism, and a duplicate role name
# stops before anything is written. Model tiers are read from agent/models.env, overridden per cell by
# KIT_MODEL_<HARNESS>_<TIER> in project/profile.env.
#
# Generated files carry the `kit:generated` marker on the first line. A file that exists without the
# marker, or that is already tracked by Git in the target, is left untouched and reported with a warning
# (--force overwrites files without the marker, never overwrites tracked files).
set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
PROJECT_ROOT="$(dirname "$SCRIPT_DIR")"
PACK_AGENT="$PROJECT_ROOT/agent"
PROJECT_AGENT="$PROJECT_ROOT/project/agent"
MARK='kit:generated'
PROJECT_MD_MAX=20

# shellcheck source=bin/lib/profile.sh
source "$SCRIPT_DIR/lib/profile.sh"

info() { printf '%s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: bin/agent install [--target <directory>] [--force]

  install    Generate AGENTS.md, CLAUDE.md, install the package and project skills and
             roles into the target directory (default: current directory). The Claude Code
             adapter writes to .claude/agents/, the Codex adapter writes to ${CODEX_HOME:-~/.codex}/agents/
  --force    Overwrite an existing file that was not generated by bin/agent

Role model tiers are read from agent/models.env. Override each cell in
project/profile.env with KIT_MODEL_<HARNESS>_<TIER>, for example KIT_MODEL_CODEX_DEEP.
USAGE
}

# is_tracked <target> <relative path>: the file is already tracked by Git in the target.
is_tracked() {
  git -C "$1" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && git -C "$1" ls-files --error-unmatch -- "$2" >/dev/null 2>&1
}

# list_names <directory> <f|d>: names of the entries (with .md stripped for files), one name per line.
list_names() {
  local dir="$1" kind="$2" entry
  [[ -d "$dir" ]] || return 0
  for entry in "$dir"/*; do
    [[ -e "$entry" ]] || continue
    case "$kind" in
      f) [[ -f "$entry" && "$entry" == *.md ]] && basename "$entry" .md ;;
      d) [[ -d "$entry" ]] && basename "$entry" ;;
    esac
  done
  return 0
}

# check_collisions <kind> <package directory> <project directory> <f|d>: stop when a
# project name collides with a package name.
check_collisions() {
  local label="$1" pack_dir="$2" project_dir="$3" kind="$4" name found=0
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    if list_names "$pack_dir" "$kind" | grep -Fqx -- "$name"; then
      warn "$label '$name' in the project collides with a package $label ($project_dir)"
      found=1
    fi
  done < <(list_names "$project_dir" "$kind")
  [[ "$found" -eq 0 ]] || die "Rename the project $label and run again, nothing has been written"
}

# writable <target> <rel> <force>: returns 0 when a generated file may be written at <target>/<rel>.
writable() {
  local dest="$1" rel="$2" force="$3" file="$1/$2"
  if is_tracked "$dest" "$rel"; then
    warn "$rel is already tracked by Git in $dest, left untouched"
    return 1
  fi
  if [[ -e "$file" ]] && ! head -n 1 "$file" | grep -Fq "$MARK" && [[ "$force" -ne 1 ]]; then
    warn "$rel already exists and was not generated by bin/agent, left untouched (--force to overwrite)"
    return 1
  fi
  return 0
}

# write_file <target> <rel> <content>: write atomically, only when the content changed.
write_file() {
  local dest="$1" rel="$2" content="$3" file="$1/$2" tmp
  if [[ -f "$file" && "$(cat "$file")" == "$content" ]]; then
    return 0
  fi
  tmp="$file.tmp.$$"
  printf '%s\n' "$content" > "$tmp"
  mv -f "$tmp" "$file"
  info "Wrote $rel"
}

render_agents() {
  local out replacement project_md="$PROJECT_AGENT/AGENTS.project.md" lines key value
  out="$(cat "$PACK_AGENT/AGENTS.template.md")"
  for key in KIT_PROJECT_NAME KIT_DOMAIN KIT_GIT_REMOTE KIT_GIT_BASE_BRANCH KIT_GIT_TARGET_BRANCH; do
    value="${!key:-}"
    [[ -n "$value" ]] || value='(not declared)'
    out="${out//\{\{$key\}\}/$value}"
  done
  replacement="$PROJECT_ROOT"
  out="${out//\{\{KIT_ROOT\}\}/$replacement}"
  if [[ -f "$project_md" ]]; then
    lines="$(wc -l < "$project_md" | tr -d ' ')"
    if [[ "$lines" -gt "$PROJECT_MD_MAX" ]]; then
      warn "project/agent/AGENTS.project.md is $lines lines long, over the limit of $PROJECT_MD_MAX, move the long part to project/agent/references/"
    fi
    out+=$'\n\n'"$(cat "$project_md")"
  fi
  printf '<!-- %s by bin/agent install, edit project/agent/AGENTS.project.md instead of this file -->\n%s' "$MARK" "$out"
}

render_claude() {
  printf '<!-- %s by bin/agent install -->\n%s' "$MARK" "$(cat "$PACK_AGENT/CLAUDE.template.md")"
}

# install_skills <target>: copy the package skills and then the project skills into .claude/skills and
# .agents/skills. A package-managed skill directory carries a .kit-managed file, another directory
# with the same name is left untouched.
install_skills() {
  local dest="$1" base name src target managed=() entry
  for base in .claude/skills .agents/skills; do
    mkdir -p "$dest/$base"
    for src in "$PACK_AGENT/skills" "$PROJECT_AGENT/skills"; do
      while IFS= read -r name; do
        [[ -n "$name" ]] || continue
        target="$dest/$base/$name"
        if [[ -d "$target" && ! -f "$target/.kit-managed" ]] || is_tracked "$dest" "$base/$name/SKILL.md"; then
          warn "$base/$name already exists and is not managed by bin/agent, left untouched"
          continue
        fi
        rm -rf "$target"
        mkdir -p "$target"
        cp -R "$src/$name/." "$target/"
        : > "$target/.kit-managed"
        managed+=("$base/$name")
      done < <(list_names "$src" d)
    done
    # Remove package-managed skills whose source is gone.
    for entry in "$dest/$base"/*/; do
      [[ -f "${entry}.kit-managed" ]] || continue
      name="${base}/$(basename "$entry")"
      printf '%s\n' "${managed[@]:-}" | grep -Fqx -- "$name" || rm -rf "$entry"
    done
  done
}

# --------------------------------------------------------------------------
# Roles and model adapters
# --------------------------------------------------------------------------

# The default model tiers live in the package's agent/models.env. Override each cell with
# KIT_MODEL_<HARNESS>_<TIER> in project/profile.env.
LEGACY_ROLES='luna-worker magento-verifier magento-releaser magento-debugger'

# role_field <file> <key>: read one frontmatter key, empty when it is missing.
role_field() {
  awk -v want="$2" '
    /^---$/ { fence++; next }
    fence == 1 {
      if (index($0, want ":") == 1) {
        line = $0
        sub(/^[^:]*:[[:space:]]*/, "", line)
        gsub(/^"|"$/, "", line)
        print line
        exit
      }
    }
  ' "$1"
}

# role_body <file>: the role body, without the frontmatter.
role_body() {
  awk '/^---$/ { fence++; next } fence >= 2' "$1"
}

# claude_tools <permission>: the tool list for the Claude Code adapter.
claude_tools() {
  case "$1" in
    read-only) printf 'Read, Grep, Glob, Bash' ;;
    *) printf 'Read, Grep, Glob, Bash, Edit, Write' ;;
  esac
}

# toml_escape <text>: escape a string for a TOML basic string.
toml_escape() {
  local text="${1//\\/\\\\}"
  printf '%s' "${text//\"/\\\"}"
}

# model_for <harness> <tier>: the real model, empty when the harness is not in the table.
model_for() {
  local harness="$1" tier="$2" key name value
  key="KIT_MODEL_$(printf '%s_%s' "$harness" "$tier" | tr '[:lower:]-' '[:upper:]_')"
  if [[ -n "${!key:-}" ]]; then printf '%s\n' "${!key}"; return 0; fi
  [[ -f "$PACK_AGENT/models.env" ]] || return 0
  while IFS='=' read -r name value; do
    [[ -n "$name" && "$name" != '#'* ]] || continue
    if [[ "$name" == "$harness.$tier" ]]; then printf '%s\n' "$value"; return 0; fi
  done < "$PACK_AGENT/models.env"
  return 0
}

# adapter_writable <directory> <rel> <force>: like writable but detects a file generated by
# bin/agent by the kit:generated marker on any line.
adapter_writable() {
  local dir="$1" rel="$2" force="$3" file="$1/$2"
  if is_tracked "$dir" "$rel"; then
    warn "$rel is already tracked by Git in $dir, left untouched"
    return 1
  fi
  if [[ -e "$file" ]] && ! grep -Fq "$MARK" "$file" && [[ "$force" -ne 1 ]]; then
    warn "$rel already exists and was not generated by bin/agent, left untouched (--force to overwrite)"
    return 1
  fi
  return 0
}

# prune_adapters <directory> <extension> <list of names to keep>: delete adapters generated by the
# package whose role is no longer in the current set.
prune_adapters() {
  local dir="$1" ext="$2" keep="$3" file base
  [[ -d "$dir" ]] || return 0
  for file in "$dir"/*"$ext"; do
    [[ -f "$file" ]] || continue
    grep -Fq "$MARK" "$file" || continue
    base="$(basename "$file" "$ext")"
    printf '%s' "$keep" | grep -Fqx -- "$base" || {
      rm -f "$file"
      info "Deleted adapter with no remaining source: $file"
    }
  done
}

# warn_legacy_adapters <Claude directory> <Codex directory>: remind to clean up old adapters.
warn_legacy_adapters() {
  local claude_dir="$1" codex_dir="$2" name
  for name in $LEGACY_ROLES; do
    [[ -f "$claude_dir/$name.md" ]] \
      && warn "legacy adapter $claude_dir/$name.md is no longer in the role set, delete it if unused"
    [[ -f "$codex_dir/$name.toml" ]] \
      && warn "legacy adapter $codex_dir/$name.toml is no longer in the role set, delete it if unused"
  done
  return 0
}

# install_roles <target> <force>: generate the Claude Code and Codex adapters from one role source.
install_roles() {
  local dest="$1" force="$2"
  local claude_dir="$dest/.claude/agents"
  local codex_dir="${CODEX_HOME:-$HOME/.codex}/agents"
  local src name rel perm tier desc body spec model effort cname content
  local claude_keep='' codex_keep=''
  mkdir -p "$claude_dir"
  for src in "$PACK_AGENT/roles" "$PROJECT_AGENT/roles"; do
    [[ -d "$src" ]] || continue
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      if [[ "$src" == "$PACK_AGENT/roles" ]]; then
        rel="agent/roles/$name.md"
      else
        rel="project/agent/roles/$name.md"
      fi
      perm="$(role_field "$src/$name.md" permission)"
      tier="$(role_field "$src/$name.md" model)"
      desc="$(role_field "$src/$name.md" description)"
      body="$(role_body "$src/$name.md")"
      if [[ ! "$perm" =~ ^(read-only|write)$ ]]; then
        warn "role '$name' must declare permission read-only or write, skipping this role"
        continue
      fi
      if [[ ! "$tier" =~ ^(fast|default|deep)$ ]]; then
        warn "role '$name' must declare a model tier of fast, default or deep, skipping this role"
        continue
      fi
      if [[ -z "$desc" || -z "$body" ]]; then
        warn "role '$name' is missing description or a role body, skipping this role"
        continue
      fi

      if adapter_writable "$dest" ".claude/agents/$name.md" "$force"; then
        model="$(model_for claude "$tier")"
        content="---
name: $name
description: $desc
tools: $(claude_tools "$perm")"
        [[ -z "$model" ]] || content+="
model: $model"
        content+="
---

<!-- $MARK by bin/agent install, edit $rel instead of this file -->
$body"
        write_file "$dest" ".claude/agents/$name.md" "$content"
      fi
      claude_keep+="$name"$'\n'

      cname="$name"
      [[ "$cname" == magento-* ]] || cname="magento-$cname"
      if ! mkdir -p "$codex_dir" 2>/dev/null; then
        warn "cannot create the Codex adapter directory: $codex_dir"
        continue
      fi
      if ! adapter_writable "$codex_dir" "$cname.toml" "$force"; then
        codex_keep+="$cname"$'\n'
        continue
      fi
      spec="$(model_for codex "$tier")"
      content="# $MARK by bin/agent install, edit $rel instead of this file
name = \"$cname\"
description = \"$(toml_escape "$desc")\""
      if [[ -n "$spec" ]]; then
        model="${spec%%:*}"
        effort=''
        [[ "$spec" == *:* ]] && effort="${spec#*:}"
        content+="
model = \"$model\""
        [[ -z "$effort" ]] || content+="
model_reasoning_effort = \"$effort\""
      fi
      content+="
developer_instructions = \"\"\"
$(toml_escape "$body")
\"\"\""
      write_file "$codex_dir" "$cname.toml" "$content"
      codex_keep+="$cname"$'\n'
    done < <(list_names "$src" f)
  done
  prune_adapters "$claude_dir" '.md' "$claude_keep"
  prune_adapters "$codex_dir" '.toml' "$codex_keep"
  warn_legacy_adapters "$claude_dir" "$codex_dir"
}

install_cmd() {
  local dest="$PWD" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --target)
        [[ $# -ge 2 ]] || die '--target needs a directory'
        dest="$2"
        shift 2
        ;;
      --force) force=1; shift ;;
      *) die "Invalid argument: $1" ;;
    esac
  done
  [[ -d "$dest" ]] || die "Target directory not found: $dest"
  dest="$(cd "$dest" && pwd -P)"
  [[ -f "$PACK_AGENT/AGENTS.template.md" ]] || die "Missing $PACK_AGENT/AGENTS.template.md"

  kit_profile_load "$PROJECT_ROOT" || die 'profile file has invalid syntax, fix project/profile.env'
  kit_profile_require KIT_GIT_REMOTE KIT_GIT_BASE_BRANCH KIT_GIT_TARGET_BRANCH \
    || die 'Fill in the Git keys in project/profile.env and run again'

  check_collisions role "$PACK_AGENT/roles" "$PROJECT_AGENT/roles" f
  check_collisions skill "$PACK_AGENT/skills" "$PROJECT_AGENT/skills" d

  if writable "$dest" AGENTS.md "$force"; then
    write_file "$dest" AGENTS.md "$(render_agents)"
  fi
  if writable "$dest" CLAUDE.md "$force"; then
    write_file "$dest" CLAUDE.md "$(render_claude)"
  fi
  install_skills "$dest"
  install_roles "$dest" "$force"
  info "Installed the agent kit into $dest"
}

main() {
  local action="${1:-help}"
  [[ $# -gt 0 ]] && shift
  case "$action" in
    install) install_cmd "$@" ;;
    help | -h | --help) usage ;;
    *) usage >&2; die "Unknown command: $action" ;;
  esac
}

main "$@"
