# The package's default model tier table, in the form <harness>.<tier>=<model>.
# Tiers: fast, default, deep. Override each cell in project/profile.env with
# KIT_MODEL_<HARNESS>_<TIER>, for example KIT_MODEL_CODEX_DEEP=gpt-5.4:high.
# On the codex side the value is <model>:<effort> and is split when the adapter is generated.
# A harness not in the table gets no model adapter, the harness uses its own default.
claude.fast=haiku
claude.default=sonnet
claude.deep=opus
codex.fast=gpt-5.4-mini:low
codex.default=gpt-5.3-codex:medium
codex.deep=gpt-5.4:high
