# Bảng hạng model mặc định của gói, dạng <harness>.<hạng>=<model>.
# Hạng: fast, default, deep. Ghi đè từng ô trong project/profile.env bằng
# KIT_MODEL_<HARNESS>_<HẠNG>, ví dụ KIT_MODEL_CODEX_DEEP=gpt-5.4:high.
# Phía codex, giá trị là <model>:<effort> và được tách khi sinh adapter.
# Harness không có trong bảng thì không sinh adapter model, harness tự dùng mặc định.
claude.fast=haiku
claude.default=sonnet
claude.deep=opus
codex.fast=gpt-5.4-mini:low
codex.default=gpt-5.3-codex:medium
codex.deep=gpt-5.4:high
