#!/usr/bin/env bash
# bin/test/ui-regression - the Playwright Test screenshot suite (toHaveScreenshot).
#
#   bin/test/ui-regression --info [--wt <name>]
#   bin/test/ui-regression [--wt <name>] [--env-file <path>] [<spec or filter>...]
#   bin/test/ui-regression --update [--wt <name>] ...      rewrite the baselines
#
# The specs, playwright.config.* and package.json are the project's, in
# dev/tests/ui-regression/ of the checkout. package.json pins @playwright/test to one
# exact version. The runner starts the official Playwright image of that same version, so
# the browser, the fonts and the anti-aliasing are always the same, and the baselines
# (committed next to the specs) mean the same on every machine. Run as the host user, so
# node_modules, test-results/ and the baselines belong to you.
#
# The site shows the served checkout, so --wt must name the served one. Switch with
# bin/wt use first. One worker only: the stack serves one checkout and one database.
# --update is for a person. An agent never runs it, the user approves new baselines.
# Spec files and filters are positional. After -- everything goes to Playwright as it is.
#
# The container reaches the site by its public name. Variables the config needs (access
# headers, BASE_URL) come from --env-file, else env/ui-regression.env when it exists,
# relative to the Docker root. A BASE_URL already set in the shell is passed as well.
#
# Exit codes: 2 usage or prerequisite, otherwise the exit code of Playwright.
set -Eeuo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
SRC="$ROOT/src"
SUITE='dev/tests/ui-regression'
DEFAULT_ENV_FILE='env/ui-regression.env'

die() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }

usage() {
  cat <<'USAGE'
Usage: bin/test/ui-regression --info [--wt <name>]
       bin/test/ui-regression [--wt <name>] [--env-file <path>] [<spec or filter>...]
       bin/test/ui-regression --update [--wt <name>] [--env-file <path>] [<spec or filter>...]

  --info            Print the checkout, the suite, the Playwright version and the image
  --wt <name>       Checkout holding the suite. Must be the served one (bin/wt status)
  --env-file <path> Variables for the container (access headers, BASE_URL), relative to the
                    Docker root. Default: env/ui-regression.env when it exists
  --update          Rewrite the baselines (--update-snapshots). A person approves first
  --                Everything after it goes to Playwright as it is, for example -- -g cart

The suite is dev/tests/ui-regression/ in the checkout: playwright.config.*, the specs and a
package.json with an exact @playwright/test version.
USAGE
}

info=0 update=0 wt='' env_file=''
filters=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --info) info=1; shift ;;
    --update) update=1; shift ;;
    --) shift; filters+=("$@"); break ;;
    --wt)
      [[ $# -ge 2 && -n "$2" ]] || die '--wt needs a worktree name'
      wt="$2"; shift 2 ;;
    --env-file)
      [[ $# -ge 2 && -n "$2" ]] || die '--env-file needs a path'
      env_file="$2"; shift 2 ;;
    -*) usage >&2; die "Unknown option: $1" ;;
    *) filters+=("$1"); shift ;;
  esac
done

# ---- served checkout and target checkout ------------------------------------
served="$(realpath -e "$ROOT/.active-src" 2>/dev/null || realpath "$SRC")"
if [[ -n "$wt" ]]; then
  target="$("$ROOT/bin/wt" path "$wt" 2>/dev/null)" || die "Unknown worktree '$wt'. See: bin/wt list"
  target="$(realpath "$target")"
else
  target="$served"
fi
if [[ "$target" == "$(realpath "$SRC")" ]]; then name='main'; else name="$(basename "$target")"; fi
[[ "$target" == "$served" ]] \
  || die "$name is not the served checkout, the site shows $(basename "$served"). Run: bin/wt use $name (ask the user first when another one is served)"

# ---- suite, version, image --------------------------------------------------
dir="$target/$SUITE"
[[ -d "$dir" ]] || die "No suite at $SUITE in $name. The project writes it: playwright.config.*, specs, package.json"
compgen -G "$dir/playwright.config.*" > /dev/null || die "$SUITE/playwright.config.* is missing"
[[ -f "$dir/package.json" ]] || die "$SUITE/package.json is missing: it pins @playwright/test"

version="$(sed -nE 's/.*"@playwright\/test"[[:space:]]*:[[:space:]]*"([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' "$dir/package.json" | head -n1)"
[[ -n "$version" ]] || die "$SUITE/package.json must pin @playwright/test to an exact version, for example \"1.49.1\" (no ^ or ~): the image and the baselines depend on it"
image="mcr.microsoft.com/playwright:v${version}-noble"

# ---- environment file ---------------------------------------------------------
if [[ -n "$env_file" ]]; then
  [[ "$env_file" != /* ]] || die '--env-file is relative to the Docker root'
  env_path="$ROOT/$env_file"
  [[ -f "$env_path" ]] || die "Env file not found: $env_file"
elif [[ -f "$ROOT/$DEFAULT_ENV_FILE" ]]; then
  env_path="$ROOT/$DEFAULT_ENV_FILE"
else
  env_path=''
fi

if [[ "$info" -eq 1 ]]; then
  printf 'checkout=%s (served)\n' "$name"
  printf 'suite=%s\n' "$dir"
  printf 'playwright=%s\n' "$version"
  printf 'image=%s\n' "$image"
  printf 'env-file=%s\n' "${env_path:-none}"
  printf 'workers=1\n'
  exit 0
fi

command -v docker > /dev/null 2>&1 || die 'docker is not installed or not on PATH'

# ---- run -----------------------------------------------------------------------
args=(run --rm --init --ipc=host
  --user "$(id -u):$(id -g)"
  -e HOME=/tmp -e CI=1
  -v "$dir:/work" -w /work)
[[ -z "$env_path" ]] || args+=(--env-file "$env_path")
[[ -z "${BASE_URL:-}" ]] || args+=(-e BASE_URL)
args+=("$image")

pw=(npx playwright test --workers=1)
[[ "$update" -eq 0 ]] || pw+=(--update-snapshots)
pw+=("${filters[@]}")

# ci keeps the lockfile honest, install fails the run when the package does not resolve.
script='if [ -f package-lock.json ]; then npm ci --no-audit --no-fund --loglevel=error; else npm install --no-audit --no-fund --loglevel=error; fi && exec "$@"'

set +e
docker "${args[@]}" bash -c "$script" _ "${pw[@]}"
status=$?
set -e

if [[ "$status" -ne 0 && "$update" -eq 0 ]]; then
  printf 'Diff images (expected, actual, diff): %s/test-results\n' "$dir" >&2
  printf 'Open the diff. A real regression is fixed in the view files. A wanted change goes to the user, who approves --update.\n' >&2
fi
exit "$status"
